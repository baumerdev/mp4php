includes:
    - phpstan-baseline.neon

parameters:
    paths:
        - "src"
        - "tests"
    level: 7
    phpVersion: 80300

    ignoreErrors:
        # Doesn't work too well with IDE code completion
        - identifier: missingType.iterableValue
        # PHPMD annotations aren't valid PHPDoc
        - message: '#^PHPDoc tag @SuppressWarnings has invalid value#'
