grumphp:
    tasks:
        composer: ~
        composer_normalize: ~
        git_commit_message: ~
        git_branch_name: ~
        file_size: ~
        phpcsfixer:
            config: .php-cs-fixer.dist.php
        phpmd:
            ruleset:
                - phpmd.xml.dist
        phpstan: ~
        phpunit: ~
        phpversion:
            project: '8.3'
