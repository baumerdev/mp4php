{
    "name": "baumerdev/mp4php",
    "description": "PHP library for parsing and modifying MP4 files",
    "license": "GPL-3.0-or-later",
    "version": "0.2.0-dev",
    "keywords": [
        "media",
        "video",
        "mp4",
        "metadata",
        "stream"
    ],
    "authors": [
        {
            "name": "Markus Baumer",
            "email": "markus@baumer.dev",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/baumerdev/mp4php",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48",
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpmd/phpmd": "^2.15",
        "phpro/grumphp": "^2.17",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Mp4php\\": "src/Mp4php/",
            "tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true
        }
    }
}
