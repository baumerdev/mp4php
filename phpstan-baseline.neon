parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset 1 on array\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Mp4php/Box/AbstractFullBox.php

		-
			message: '#^Call to function is_a\(\) with Mp4php\\Box\\Box and ''Mp4php\\\\Box\\\\Box'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/Box.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/Box.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Mp4php/Box/Box.php

		-
			message: '#^Property Mp4php\\Box\\Box\:\:\$offset \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Mp4php/Box/BoxInfoTrait.php

		-
			message: '#^Property Mp4php\\Box\\Box\:\:\$size \(int\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Mp4php/Box/BoxInfoTrait.php

		-
			message: '#^Property Mp4php\\Box\\Box\:\:\$type \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Mp4php/Box/BoxInfoTrait.php

		-
			message: '#^Dead catch \- ReflectionException is never thrown in the try block\.$#'
			identifier: catch.neverThrown
			count: 1
			path: src/Mp4php/Box/BoxValidation.php

		-
			message: '#^Method Mp4php\\Box\\ChunkLargeOffsetBox\:\:unpackEntrySize\(\) should return array\<int\> but returns array\|false\.$#'
			identifier: return.type
			count: 1
			path: src/Mp4php/Box/ChunkLargeOffsetBox.php

		-
			message: '#^Method Mp4php\\Box\\ChunkOffsetBox\:\:unpackEntrySize\(\) should return array\<int\> but returns array\|false\.$#'
			identifier: return.type
			count: 1
			path: src/Mp4php/Box/ChunkOffsetBox.php

		-
			message: '#^Parameter \#1 \$valueBitStreamMode of method Mp4php\\Box\\Codec\\CodecDAC3Box\:\:parseBitStreamMode\(\) expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Parameter \#1 \$valueBitrate of method Mp4php\\Box\\Codec\\CodecDAC3Box\:\:parseBitrate\(\) expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Parameter \#1 \$valueChannel of method Mp4php\\Box\\Codec\\CodecDAC3Box\:\:parseChannels\(\) expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Parameter \#1 \$valueSampleRate of method Mp4php\\Box\\Codec\\CodecDAC3Box\:\:parseSampleRate\(\) expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Parameter \#2 \$valueChannel of method Mp4php\\Box\\Codec\\CodecDAC3Box\:\:parseBitStreamMode\(\) expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Property Mp4php\\Box\\Codec\\CodecDAC3Box\:\:\$bitStreamId \(int\) does not accept float\|int\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Mp4php/Box/Codec/CodecDAC3Box.php

		-
			message: '#^Parameter \#1 \$data of method Mp4php\\File\\MP4WriteHandle\:\:write\(\) expects string, string\|false given\.$#'
			identifier: argument.type
			count: 3
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Parameter \#1 \$num of function decbin expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Parameter \#1 \$num of function dechex expects int, float\|int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Property Mp4php\\Box\\Codec\\CodecDEC3Box\:\:\$atmosObjectCount \(int\|null\) does not accept float\|int\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Property Mp4php\\Box\\Codec\\CodecDEC3Box\:\:\$atmosVersion \(int\) does not accept float\|int\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Property Mp4php\\Box\\Codec\\CodecDEC3Box\:\:\$datarate \(int\) does not accept float\|int\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Mp4php/Box/Codec/CodecDEC3Box.php

		-
			message: '#^Call to function is_array\(\) with array\<Mp4php\\Box\\Itunes\\ValueBoxData\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/Mp4php/Box/Itunes/ValueBox.php

		-
			message: '#^Call to function is_a\(\) with Mp4php\\Box\\MediaBox and ''Mp4php\\\\Box\\\\MediaBox'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/MediaInformationBox.php

		-
			message: '#^Call to function is_object\(\) with Mp4php\\Box\\MediaBox will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/MediaInformationBox.php

		-
			message: '#^Property Mp4php\\Box\\NameBox\:\:\$name \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Mp4php/Box/NameBox.php

		-
			message: '#^Call to function is_a\(\) with Mp4php\\Box\\SampleTableBox and ''Mp4php\\\\Box\\\\SampleTableBox'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/SampleDescriptionBox.php

		-
			message: '#^Call to function is_object\(\) with Mp4php\\Box\\SampleTableBox will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/SampleDescriptionBox.php

		-
			message: '#^Call to function is_a\(\) with Mp4php\\Box\\MediaInformationBox and ''Mp4php\\\\Box\\\\MediaInformationBox'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/SampleTableBox.php

		-
			message: '#^Call to function is_object\(\) with Mp4php\\Box\\MediaInformationBox will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Box/SampleTableBox.php

		-
			message: '#^Property Mp4php\\Box\\TitleBox\:\:\$title \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: src/Mp4php/Box/TitleBox.php

		-
			message: '#^Parameter \#1 \$codepoint of function chr expects int, float\|int given\.$#'
			identifier: argument.type
			count: 5
			path: src/Mp4php/DataType/Language.php

		-
			message: '#^Offset ''size'' on array\{0\: int, 1\: int, 2\: int, 3\: int, 4\: int, 5\: int, 6\: int, 7\: int, \.\.\.\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/Mp4php/File/FileHandle.php

		-
			message: '#^Parameter \#2 \$length of function fread expects int\<1, max\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/File/FileHandle.php

		-
			message: '#^Parameter \#2 \$size of function ftruncate expects int\<0, max\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/File/FileHandle.php

		-
			message: '#^Cannot access offset 1 on array\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/Mp4php/File/MP4ReadHandle.php

		-
			message: '#^Parameter \#2 \$length of function fread expects int\<1, max\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: src/Mp4php/File/MP4ReadHandle.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: src/Mp4php/Mp4php.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Mp4php/Mp4php.php

		-
			message: '#^Call to function is_a\(\) with Mp4php\\Box\\MediaDataCombinedBox and ''Mp4php\\\\Box\\\\MediaDataCombinedBox'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Mp4php/Optimize.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Mp4php/Save.php

		-
			message: '#^Call to method Mp4php\\Box\\DataInformationBox\:\:getDataReference\(\) on a separate line has no effect\.$#'
			identifier: method.resultUnused
			count: 1
			path: tests/Mp4php/Box/DataInformationBoxTest.php

		-
			message: '#^Offset 0 does not exist on null\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: tests/Mp4php/Box/DataReferenceBoxTest.php

		-
			message: '#^Parameter \#2 \$haystack of method PHPUnit\\Framework\\Assert\:\:assertCount\(\) expects Countable\|iterable, null given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Mp4php/Box/DataReferenceBoxTest.php
